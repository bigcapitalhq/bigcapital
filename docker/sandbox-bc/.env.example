# Sandbox .env — copy from staging/.env and change the variables noted below.
# Most values (DB creds, JWT_SECRET, Plaid, Stripe, etc.) are copied verbatim
# from staging so cloned data continues to resolve.

# ──────────────────────────────────────────────────────────────────────────
# CHANGED vs staging (everything in this block MUST be different)
# ──────────────────────────────────────────────────────────────────────────

# Public URL of the sandbox (new DNS entry + Traefik router).
BASE_URL=https://sandbox.bc.jjocllc.com
WEBAPP_BASE_URL=https://sandbox.bc.jjocllc.com

# Internal URLs that reference the sandbox container_name:
GOTENBERG_DOCS_URL=http://bigcapital-sandbox-server:3000/public/
S3_ENDPOINT=http://bigcapital-sandbox-minio:9000

# Square — use a SECOND Square sandbox OAuth app dedicated to this host, so
# the staging and sandbox environments don't fight over a single redirect URI.
# Register https://sandbox.bc.jjocllc.com/api/integrations/square/oauth/callback
# on the new app.
SQUARE_APPLICATION_ID=<sandbox-app-id-for-sandbox-host>
SQUARE_APPLICATION_SECRET=<sandbox-app-secret-for-sandbox-host>
SQUARE_ENVIRONMENT=sandbox
SQUARE_OAUTH_REDIRECT_URL=https://sandbox.bc.jjocllc.com/api/integrations/square/oauth/callback

# Fresh encryption key — DO NOT reuse staging's key.  `openssl rand -hex 32`
SQUARE_TOKEN_ENCRYPTION_KEY=<64 hex chars, distinct from staging>

# ──────────────────────────────────────────────────────────────────────────
# COPY verbatim from staging/.env so the cloned MySQL + MinIO data
# continues to authenticate and decrypt:
# ──────────────────────────────────────────────────────────────────────────
#   DB_USER, DB_PASSWORD, DB_ROOT_PASSWORD, DB_CHARSET,
#   SYSTEM_DB_NAME, TENANT_DB_NAME_PERFIX,
#   JWT_SECRET,
#   S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_REGION, S3_BUCKET,
#   S3_FORCE_PATH_STYLE,
#   MAIL_*, PLAID_*, STRIPE_*, LEMONSQUEEZY_*, EXCHANGE_RATE_*,
#   SIGNUP_*, GOTENBERG_URL, THROTTLE_*, BANK_FEED_ENABLED,
#   HOSTED_ON_BIGCAPITAL_CLOUD.

# ──────────────────────────────────────────────────────────────────────────
# NOTE on Plaid & Stripe webhooks:
# Their webhook URLs still point at staging.bc.jjocllc.com.  On the sandbox
# you'll see "no Plaid updates" — fine for Square testing. If you want live
# bank sync here too, create parallel Plaid/Stripe apps and update their
# CLIENT_ID/SECRET/WEBHOOK_URL for the sandbox host.
# ──────────────────────────────────────────────────────────────────────────
