{
  "name": "@bigcapital/example-reports",
  "version": "1.0.0",
  "private": true,
  "description": "Reference Bigcapital extension: custom reports.",
  "license": "AGPL-3.0",
  "main": "./dist/server/index.js",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "require": "./dist/server/index.js",
      "import": "./dist/server/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "require": "./dist/server/index.js",
      "import": "./dist/server/index.mjs"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "require": "./dist/web/index.js",
      "import": "./dist/web/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/server/index.d.ts"
      ],
      "web": [
        "dist/web/index.d.ts"
      ]
    }
  },
  "bigcapital": {
    "manifestVersion": 1,
    "id": "bigcapital.example-reports",
    "name": "Example Reports",
    "version": "1.0.0",
    "apiVersion": "^1.0.0",
    "trust": "native",
    "server": {
      "entry": "./dist/server/index.js"
    },
    "web": {
      "entry": "./dist/web/index.js"
    },
    "migrations": "./dist/migrations",
    "capabilities": [
      "tenant.db.read",
      "ui.routes",
      "ui.slots"
    ],
    "features": [],
    "abilities": [],
    "settings": [
      {
        "key": "default_period",
        "type": "string",
        "title": "Default period",
        "defaultValue": "this_year",
        "public": true,
        "required": false
      }
    ],
    "defaultEnabled": false
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bigcapital/extension-sdk": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@types/node": "^20.3.1",
    "@types/react": "^18.3.4",
    "knex": "^3.1.0",
    "react": "^18.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.1.3",
    "vitest": "^2.1.3"
  }
}
