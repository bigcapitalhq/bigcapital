# Install at /etc/cron.d/bigcapital-uat-backup (mode 0644 root:root).
# Daily at 03:47 UTC (offset 30 min from sandbox to avoid concurrent restic locks).
# Path reflects the actual on-host env dir (staging-bc, despite the workflow's
# "uat" internal name — see docs/CI-CD.md for the naming history).

47 3 * * * root /srv/portal/clients/staging-bc/backup.sh 2>&1 | logger -t bc-uat-backup
